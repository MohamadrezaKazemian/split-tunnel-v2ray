{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Split Tunnel",
  "version": "0.1.0",
  "identifier": "io.github.mohamadrezakazemian.splittunnel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Split Tunnel",
        "width": 840,
        "height": 720,
        "minWidth": 580,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/sing-box"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
