{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Split Tunnel",
  "version": "0.1.0",
  "identifier": "io.github.mohamadrezakazemian.splittunnel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Split Tunnel",
        "width": 840,
        "height": 720,
        "minWidth": 580,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/sing-box"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENjg3NTUzQjI5N0JDNTEKUldSUnZKZXlVM1ZvSGZlSWN1NUEwOW9LdHhObmhCTlJtZ0U4TExhVDdQRFV5MkE0a1llSkpDN3EK",
      "endpoints": ["https://github.com/MohamadrezaKazemian/split-tunnel-v2ray/releases/latest/download/latest.json"]
    }
  }
}
